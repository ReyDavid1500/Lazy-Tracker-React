# URL of your NestJS backend (Render URL in production)
VITE_API_URL=https://your-backend.onrender.com

# VAPID public key from: npx web-push generate-vapid-keys
# Run that command in your NestJS project and paste the PUBLIC key here
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
